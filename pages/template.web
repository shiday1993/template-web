var menu = fn(p, c, sess) {
    var ret = []
    var resource_user = []
    each(resource, fn(e, i) {
        if (is(e[2], "FUNCTION")) {
            set(e, 2, e[2](p, c, sess))
        }
        if (e[3] == null) {
            resource_user + e
        } else {
            if (empty(sess)) {
                if (e[3] == false) {
                    resource_user + e
                }
            } else {
                if (e[3] == true) {
                    resource_user + e
                }
            }
        }
    })

    ret + "
        <div class='offcanvas-body sidebar-wrapper mw-auto p-0'>
            <nav class='mt-2'>
                <ul class='nav sidebar-menu flex-column' 
                id='sidebarAccordion'>
    "
    each(resource_user, fn(e, i) {
        var is_active = ""
        if (e[1] == p | e[0] == c) {
            var is_active = " active"
        }

        var f = e[2]
        var b = ""
        if ((!empty(string(f[1]))) & (!empty(string(f[2])))) {
            var b = ("<span class='badge " + f[1] + " ms-auto'>
                " + f[2] + "
            </span>")
        }
        if (!empty(e[6])) {
            var target_id = "submenu_" + string(i)
            var show_class = ""
            var collapsed_class = " collapsed"
            var aria_exp = "false"
            
            if (e[7] == true) {
                var show_class = " show"
                var collapsed_class = ""
                var aria_exp = "true"
            }
            ret + ("<li class='nav-item'>")
            ret + ("
                <a href='#" + target_id + "' 
                    class='nav-link d-flex 
                    justify-content-between align-items-center
                    " + collapsed_class + "' 
                    data-bs-toggle='collapse' role='button' 
                    aria-expanded='" + aria_exp + "'>
                    <div class='d-flex align-items-center'>
                        <i class='bi " + e[4] + " me-2'></i>
                        <span>" + f[0] + "</span>
                    </div>
                    <div class='d-flex align-items-center gap-2'>
                        " + b + "
                        <i class='bi bi-chevron-down arrow-icon'></i>
                    </div>
                </a>
            ")
            ret + ("
                <div class='collapse" + show_class + "' 
                    id='" + target_id + "' 
                    data-bs-parent='#sidebarAccordion'>
                    <ul class='nav flex-column ms-3'>
            ")
            each(e[6], fn(ee, ii) {
                var ff = ee[1](p, c, sess, f)
                var child_active = ""
                if (ee[0] == p) {
                    var child_active = " active"
                }
                var bb = ""
                if (
                    (!empty(string(ff[1]))) & 
                    (!empty(string(ff[2])))) {
                    var bb = ("<span class='badge 
                        " + ff[1] + " ms-auto'>" + ff[2] + "
                    </span>")
                }
                ret + ("
                    <li class='nav-item'>
                        <a href='" + ee[0] + "' 
                            class='nav-link
                                d-flex justify-content-between 
                                align-items-center
                                "+ child_active + "'>
                            <div class='d-flex align-items-center'>
                                <i class='bi " + ee[2] + " me-2'></i>
                                <span>" + ff[0] + "</span>
                            </div>
                            " + bb + "
                        </a>
                    </li>
                ")
            })
            ret + ("
                    </ul>
                </div>
            ")
            ret + ("</li>")

        } else {
            ret + ("<li class='nav-item'>")
            ret + ("
                <a href='" + e[1] + "' 
                    class='nav-link" + is_active + "'>
                    <i class='bi " + e[4] + " me-2'></i>
                    <p>" + f[0] + "</p>" + b + "
                </a>
            ")
            ret + ("</li>")
        }
    })
    ret + "
                </ul>
            </nav>
        </div>
    "
    return join(newline(), ret)
}

var navbar_menu = fn(p, c, sess) {
    var ret = []
    var resource_user = []
    each(resource, fn(e, i) {
        if (is(e[2], "FUNCTION")) {
            set(e, 2, e[2](p, c, sess))
        }
        if (e[3] == null) {
            resource_user + e
        } else {
            if (empty(sess)) {
                if (e[3] == false) { resource_user + e }
            } else {
                if (e[3] == true) { resource_user + e }
            }
        }
    })

    ret + "<ul class='navbar-nav d-none d-md-flex me-auto'>"

    each(resource_user, fn(e, i) {
        var is_active = ""
        if (e[1] == p | e[0] == c) {
            var is_active = " active"
        }
        var f = e[2]
        var b = ""
        if ((!empty(string(f[1]))) & (!empty(string(f[2])))) {
            var b = ("<span class='badge " + f[1] + " ms-2'>" + f[2] + "</span>")
        }
        if (!empty(e[6])) {
            ret + "<li class='nav-item dropdown'>"
            ret + "  <a class='nav-link dropdown-toggle" + is_active + "' href='#' data-bs-toggle='dropdown'>" + f[0] + "</a>"
            ret + "  <ul class='dropdown-menu'>"

            each(e[6], fn(ee, ii) {
                var ff = ee[1](p, c, sess, f)
                var bb = ""
                if ((!empty(string(ff[1]))) & (!empty(string(ff[2])))) {
                    var bb = ("<span class='badge " + ff[1] + " ms-2'>" + ff[2] + "</span>")
                }

                ret + "    <li>"
                ret + "      <a href='" + ee[0] + "' class='dropdown-item d-flex justify-content-between align-items-center'>"
                ret + "        <span>" + ff[0] + "</span>" + bb
                ret + "      </a>"
                ret + "    </li>"
            })

            ret + "  </ul>"
            ret + "</li>"
        } else {
            ret + "<li class='nav-item'>"
            ret + "  <a href='" + e[1] + "' class='nav-link" + is_active + "'>" + f[0] + b + "</a>"
            ret + "</li>"
        }
    })

    ret + "</ul>"
    return join(newline(), ret)
}

var toolbar = fn(sess, tb) {
    var ret = []
    each(tb, fn(e, i) {
        ret + ("
        <li class='nav-item'>
            <a class='nav-link px-2' href='" + e[0] + "'>
                <i class='bi " + e[1] + "'></i>
            </a>
        </li>")
    })
    if (!empty(ret)) {
        ret + "<li class='ms-3'></li>"
    }
    return join(newline(), ret)
}

var menu_account = fn(sess, tb) {
    if (empty(sess)) {
        return ""
    }
    var uname = sess["user"]
    var ret = []
    ret + ("
            <ul class='navbar-nav ms-3'>" +
                toolbar(sess, tb) + "
                <li class='nav-item dropdown'>
                    <a class='nav-link 
                        dropdown-toggle
                        d-flex align-items-center'
                        data-bs-toggle='dropdown'>
                        <i class='nav-icon bi bi-person-circle 
                            fs-5 fw-bold me-2'></i>
                        <span class='d-lg-inline fw-medium fs-6'>
                            " + uname + "
                        </span>
                    </a>
                    <ul class='dropdown-menu dropdown-menu-end'>                  
    ")
    each(resource_account, fn(e, i) {
        ret + "<li>"
        if (empty(e)) {
            ret + "<hr class='dropdown-divider'>"
        } else {
            ret + ("<a class='dropdown-item 
                                d-flex 
                                align-items-center " + 
                                e[4] + "' href='" + 
                                e[1] + "'>")
            ret + ("<i class='me-2 " + e[3] + "'></i>")
            ret + ("<span>" + e[2] + "</span>")
            ret + "</a>"
        }
        ret + "</li>"
    })
    ret + ("
                    </ul>
                </li>
            </ul>
    ")
    return join(newline(), ret)
}

var body_class = fn(sess) {
    var ret = ["layout-fixed",
        "fixed-header",
        "sidebar-expand-lg",
        "bg-body-tertiary"
    ]
    return join(" ", ret)
}

var breadcrumb = fn(p, c, sess, bc) {
    if (empty(bc)) {
        return ""
    }

    var ret = []
    ret + "<div class='row'><div class='col-12'>"
    ret + "<ol class='breadcrumb mb-0 text-sm'>"
    each(bc, fn(e, i) {
        var x = ""
        var a = ""
        if (e[0] == p | e[0] == c) {
            var x = " active"
            var a = e[1]
        } else {
            var a = "<a href='" + e[0] + "'>" + e[1] + "</a>"
        }
        ret + ("<li class='breadcrumb-item" + x + "'>")
        ret + a
        ret + "</li>"
        
    })
    ret + "</ol>"
    ret + "</div></div>"
    return join(newline(), ret)
}

